{
    "openapi": "3.0.0",
    "info": {
        "title": "ADN ERP API Documentation",
        "description": "Documentación de la API de ADN ERP",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "https://laravel8_admin.test/api/v1",
            "description": "Servidor local"
        },
        {
            "url": "https://laravel8_admin.test/api/v1",
            "description": "Servidor local"
        },
        {
            "url": "/api/v1"
        }
    ],
    "paths": {
        "/companies/{company}/products": {
            "get": {
                "tags": [
                    "Productos"
                ],
                "summary": "Obtener lista de productos por empresa",
                "operationId": "2a7dada8e9f939743dbc3c5ada2d5139",
                "parameters": [
                    {
                        "name": "company",
                        "in": "path",
                        "description": "ID de la compañía de la cual se quieren listar los productos",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Listado de productos devuelto correctamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Producto"
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Compañía no encontrada"
                    }
                }
            }
        },
        "/api/v1/products": {
            "post": {
                "tags": [
                    "Productos"
                ],
                "summary": "Crear un nuevo producto",
                "operationId": "c42372551809b54ed9829880ca18d93b",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ProductoCreateRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Producto creado correctamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Producto"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/items/providers": {
            "get": {
                "tags": [
                    "Líneas de pedido"
                ],
                "summary": "Obtener líneas de pedidos filtradas por uno o más company_id",
                "operationId": "fea1c7b15750ba81addad2093742c82d",
                "parameters": [
                    {
                        "name": "company_ids",
                        "in": "query",
                        "description": "IDs de las compañías, separados por comas. Ejemplo: `?company_ids=1,2,3`",
                        "required": true,
                        "style": "form",
                        "explode": false,
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "integer",
                                "format": "int64",
                                "example": 4
                            }
                        }
                    },
                    {
                        "name": "start_date",
                        "in": "query",
                        "description": "Fecha de inicio para filtrar (YYYY-MM-DD)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date",
                            "example": "2025-02-01"
                        }
                    },
                    {
                        "name": "end_date",
                        "in": "query",
                        "description": "Fecha de fin para filtrar (YYYY-MM-DD)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date",
                            "example": "2025-06-30"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Listado de items devuelto correctamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Items"
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No se encontraron líneas para los company_id indicados"
                    }
                }
            }
        }
    },
